# 前端Dockerfile
FROM node:20-alpine

WORKDIR /app

# 复制package.json
COPY package*.json ./
RUN npm install

# 复制源码
COPY . .

# 构建
RUN npm run build

# 使用nginx托管
FROM nginx:alpine
COPY --from=0 /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
